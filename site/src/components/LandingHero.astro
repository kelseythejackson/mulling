---
// The landing page's hero: one large loader that steps through the AI states once, then waits.
import pkg from '../../../package.json';
import Loader from './Loader.astro';
import sizes from '../data/sizes.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const snippet = `<script src="https://cdn.jsdelivr.net/npm/mulling@1/dist/mulling.umd.js"></script>
<script>Mulling.defineElement();</script>

<mulling-status state="thinking"></mulling-status>`;
const states = [
  { id: 'thinking', label: 'Thinking', status: 'Thinking about your question' },
  { id: 'searching', label: 'Searching', status: 'Searching 3 sources' },
  { id: 'writing', label: 'Writing', status: 'Writing the answer' },
  { id: 'done', label: 'Done', status: 'Answer ready' },
  { id: 'error', label: 'Error', status: 'Something went wrong' },
];
---
<section class="hero not-content">
  <div class="copy">
    <p class="eyebrow"><span class="pill">v{pkg.version}</span> Stable API · {sizes.everything} · no dependencies</p>
    <h1 id="_top">Show what the AI is working on, not just that it’s busy.</h1>
    <p class="lede">Thinking, searching, writing, done. Each step has its own loader, and screen readers hear every change once.</p>
    <div class="cta">
      <a class="btn primary" href={`${base}/start/quick-start/`}>Get started</a>
      <span class="install"><code>&lt;script src="…/mulling@1"&gt;</code><button type="button" class="copy-btn" data-copy={snippet} title="Copies the script tags and an example element, ready to paste into any HTML page">Copy snippet</button></span>
      <a class="alt" href={`${base}/start/installation/#use-a-package-manager`}>or <code>npm i mulling</code></a>
    </div>
  </div>

  <div class="stage site-card" data-stage>
    <div class="view">
      <span class="tag" data-stage-tag>96px · thinking</span>
      <Loader state="thinking" size={96} />
    </div>
    <div class="bar">
      <div class="site-seg" role="radiogroup" aria-label="AI state" data-state-group>
        {states.map((s, i) => <button type="button" role="radio" data-state={s.id} data-status={s.status} aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button>)}
      </div>
      <p class="status"><Loader state="thinking" size={16} /><span data-stage-status>{states[0].status}</span></p>
    </div>
  </div>
</section>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--site-space-64); align-items: center; padding: var(--site-space-72) 0 var(--site-space-64); }
  .eyebrow { display: flex; gap: var(--site-space-8); align-items: center; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .pill { border: 1px solid var(--site-control-border); border-radius: var(--site-radius-full); padding: var(--site-space-2) var(--site-space-8); color: var(--sl-color-white); }
  h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.04; letter-spacing: -.04em; font-weight: 600; color: var(--sl-color-white); margin: var(--site-space-16) 0; }
  .lede { font-size: var(--sl-text-lg); color: var(--sl-color-gray-3); max-width: 31rem; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--site-space-12); margin-top: var(--site-space-32); align-items: center; }
  .btn { display: inline-flex; align-items: center; height: var(--site-control-lg); padding: 0 var(--site-space-16); border-radius: var(--site-radius-md); font-weight: 500; font-size: var(--sl-text-sm); text-decoration: none; }
  .btn.primary { background: var(--sl-color-white); color: var(--sl-color-black); }
  .btn.primary:hover { opacity: .88; }
  .install { display: inline-flex; align-items: center; gap: var(--site-space-12); height: var(--site-control-lg); padding: 0 var(--site-space-6) 0 var(--site-space-16); border: 1px solid var(--site-control-border); border-radius: var(--site-radius-md); background: var(--sl-color-gray-6); }
  .install code { font-family: var(--__sl-font-mono); font-size: var(--sl-text-xs); color: var(--sl-color-white); }
  .alt { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); text-decoration: underline; text-underline-offset: 3px; }
  .alt:hover { color: var(--sl-color-white); }
  .alt code { font-family: var(--__sl-font-mono); font-size: inherit; background: none; padding: 0; }
  .copy-btn { all: unset; cursor: pointer; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); padding: var(--site-space-4) var(--site-space-8); border-radius: var(--site-radius-sm); }
  .copy-btn:hover { color: var(--sl-color-white); background: var(--sl-color-black); }
  .copy-btn:focus-visible { outline: 2px solid var(--sl-color-accent); }
  .stage { overflow: hidden; background: var(--sl-color-gray-6); }
  .view { position: relative; height: 18rem; display: grid; place-items: center; color: var(--sl-color-accent);
    background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--sl-color-accent) 8%, transparent), transparent 60%); }
  .tag { position: absolute; left: var(--site-space-16); top: var(--site-space-12); font-family: var(--__sl-font-mono); font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); }
  .bar { display: flex; flex-wrap: wrap; gap: var(--site-space-12); align-items: center; justify-content: space-between; padding: var(--site-space-12) var(--site-space-16); border-top: 1px solid var(--sl-color-hairline); background: var(--sl-color-black); }
  .status { display: flex; align-items: center; gap: var(--site-space-8); font-size: var(--sl-text-xs); margin: 0; color: var(--sl-color-gray-3); }
  .status :global(mulling-status) { color: var(--sl-color-accent); }
  /* Narrow phones: the five states wrap instead of running off the card. */
  .bar .site-seg { flex-wrap: wrap; }
  @media (max-width: 56rem) { .hero { grid-template-columns: 1fr; gap: var(--site-space-40); padding-top: var(--site-space-40); } }
</style>

<script>
  import { copyText } from '../scripts/copy.ts';
  import { PAUSE_EVENT } from '../scripts/loaders.ts';
  import { radioGroup } from '../scripts/radio.ts';

  for (const b of document.querySelectorAll<HTMLButtonElement>('.hero [data-copy]')) b.addEventListener('click', () => copyText(b, b.dataset.copy ?? ''));

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) {
    const buttons = [...stage.querySelectorAll<HTMLButtonElement>('[data-state]')];
    const loaders = stage.querySelectorAll('mulling-status');
    const tag = stage.querySelector('[data-stage-tag]')!;
    const status = stage.querySelector('[data-stage-status]')!;
    const show = (b: HTMLButtonElement) => {
      group.check(b);
      for (const l of loaders) l.setAttribute('state', b.dataset.state!);
      tag.textContent = `96px · ${b.dataset.state}`;
      status.textContent = b.dataset.status!;
    };
    let timer: ReturnType<typeof setTimeout> | undefined;
    let picked = false; // once the visitor picks a state, autoplay stays off
    const group = radioGroup(stage.querySelector<HTMLElement>('[data-state-group]')!, (b) => {
      picked = true;
      clearTimeout(timer);
      show(b);
    });

    // Plays thinking → searching → writing → done, rests on done, then starts again, so the hero is still
    // moving whenever someone looks at it. Stops for good when the visitor picks a state, and never runs
    // under reduced motion or while motion is paused (checked on every step, and when the pause changes).
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const STEP = 2200;
    const REST = 4000;
    // The page attribute, not storage: it's right even where storage is blocked.
    const paused = () => document.documentElement.hasAttribute('data-loaders-paused');
    let i = 0;
    const step = () => {
      if (reduced.matches || paused()) return;
      i = (i + 1) % 4;
      show(buttons[i]);
      timer = setTimeout(step, i === 3 ? REST : STEP);
    };
    const start = () => {
      clearTimeout(timer);
      if (!reduced.matches && !paused()) timer = setTimeout(step, STEP);
    };
    document.addEventListener(PAUSE_EVENT, (e) => {
      clearTimeout(timer);
      if (!(e as CustomEvent<boolean>).detail && !picked) start();
    });
    start();
  }
</script>
