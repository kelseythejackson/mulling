# Optional settings. None are needed to run the project locally.
# They're read from your shell, not loaded from a .env file: export them, or put them before a command,
# for example `CHROME_PATH=/usr/bin/google-chrome npm run test:site`.

# Use an installed Chrome for the browser tests and the site check, instead of Playwright's own browser.
# CHROME_PATH=/usr/bin/google-chrome

# Skip the accessibility scan in `npm run test:site` and run only the link and behavior checks (faster).
# SKIP_AXE=1

# Run `npm run test:site` against a site that's already running, instead of serving site/dist itself.
# BASE=http://localhost:4321/mulling

# Where the docs site is published. Only needed when building it for deployment.
# SITE_URL=https://your-name.github.io
# SITE_BASE=/mulling
